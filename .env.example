# Copy to .env and edit before `docker compose up -d --build`.
# Every value has a demo default, so this file is optional locally,
# but CHANGE THEM on a public VPS.
PUBLIC_URL=http://localhost          # the URL users type in the browser (CORS for socket.io), e.g. http://203.0.113.10
WEB_PORT=80
ADMIN_PORT=8000
APP_SECRET=change-me-to-a-long-random-string
JWT_PASSPHRASE=change-me-jwt-passphrase
DB_PASSWORD=weebid_db_pass
DB_ROOT_PASSWORD=weebid_root_pass
ADMIN_EMAIL=admin@weebid.local
ADMIN_PASSWORD=admin1234
