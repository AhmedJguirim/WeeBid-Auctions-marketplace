# =====================================================================================
# WeeBid configuration TEMPLATE.
#
# Do NOT edit and commit this file. Create your own private `.env` next to it:
#
#       scripts/init-env.sh
#
# (it generates random secrets for you; `.env` is git-ignored and only exists on your machine
# or on your server). Docker Compose reads `.env` when the containers START, so the images
# never contain a secret and nothing sensitive is ever pushed to GitHub.
# =====================================================================================

# --- public address ------------------------------------------------------------------
# The exact URL typed in the browser, port included (needed by the real-time server).
PUBLIC_URL=http://localhost:18080
WEB_PORT=18080
# Admin dashboard (EasyAdmin): http://<host>:18000/admin. 18000 = reachable from the internet.
# It does not pass through nginx, so the login is NOT rate-limited: the generated admin password is long and random.
# To keep it private (SSH tunnel only) use ADMIN_PORT=127.0.0.1:18000 (init-env.sh --private-admin).
ADMIN_PORT=18000

# --- secrets and names: REQUIRED, the stack refuses to start while a CHANGE_ME is left ---
APP_SECRET=CHANGE_ME
JWT_PASSPHRASE=CHANGE_ME
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
SOCKET_PASSWORD=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# --- options ---------------------------------------------------------------------------
# Language of the notifications created by the real-time server: fr or en (the interface itself switches live)
NOTIFICATION_LANG=fr
